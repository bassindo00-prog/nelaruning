# Telegram — buat bot via @BotFather di Telegram, lalu salin tokennya
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# RunningHub — API key dari dashboard RunningHub (settings → API)
RUNNINGHUB_API_KEY=
# OpenAPI v2 — semua endpoint (upload/run/query) relatif ke base ini
RUNNINGHUB_BASE_URL=https://www.runninghub.ai/openapi/v2
# Workflow Motion Control V1 (Kling Motion Control Pro) — 1080p, 1300 token per generate
RUNNINGHUB_WORKFLOW_ID=1998198427450269697

# ===== RunningHub Configuration =====
# Instance type untuk V1: kosongkan (undefined) untuk default instance
# PENTING: Jangan isi RUNNINGHUB_INSTANCE_TYPE untuk V1 - auto-detect
RUNNINGHUB_INSTANCE_TYPE=

# Polling interval (ms) — cek status job
RUNNINGHUB_POLL_INTERVAL=5000

# Timeout total menunggu job selesai (ms) — default 30 menit
RUNNINGHUB_TIMEOUT=1800000

# Berapa lama hasil disimpan di server RunningHub (detik)
RUNNINGHUB_RETAIN_SECONDS=60

# Path endpoint run: `run/ai-app` untuk V1 (Kling)
RUNNINGHUB_RUN_PATH=run/ai-app

# Mapping/workflow: `aiwood` untuk V1 Kling Motion Control
RUNNINGHUB_MAPPING=aiwood

# Folder unduhan lokal
OUTPUT_DIR=downloads

# ===== TOP UP KREDIT SYSTEM =====
# Admin Telegram ID (user yang bisa approve/reject topup requests)
ADMIN_TELEGRAM_ID=YOUR_ADMIN_TELEGRAM_ID_HERE

# Path ke QRIS image (untuk payment instructions)
QRIS_IMAGE_PATH=./qris.jpg
