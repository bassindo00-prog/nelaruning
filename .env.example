# Telegram — buat bot via @BotFather di Telegram, lalu salin tokennya
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# RunningHub — API key dari dashboard RunningHub (settings → API)
RUNNINGHUB_API_KEY=
# OpenAPI v2 — semua endpoint (upload/run/query) relatif ke base ini
RUNNINGHUB_BASE_URL=https://www.runninghub.ai/openapi/v2
# Workflow Motion Control — ID dari dashboard RunningHub
RUNNINGHUB_WORKFLOW_ID=1998198427450269697

# ===== Opsional =====
# Interval polling status job (ms)
RUNNINGHUB_POLL_INTERVAL=5000
# Timeout total menunggu job selesai (ms) — default 30 menit
RUNNINGHUB_TIMEOUT=1800000
# Berapa lama hasil disimpan di server RunningHub (detik) — valid 10–180, khusus Enterprise Shared key
RUNNINGHUB_RETAIN_SECONDS=60
# Tipe instance RunningHub: "default" (24G VRAM) atau "plus" (48G VRAM); kosongkan = default
RUNNINGHUB_INSTANCE_TYPE=
# Path endpoint run: `run/workflow` (ComfyUI) atau `run/ai-app` (AI App resmi)
RUNNINGHUB_RUN_PATH=run/workflow
# Profil mapping node: `wananimate` | `scail` | `aiapp`
RUNNINGHUB_MAPPING=wananimate
# Folder unduhan lokal
OUTPUT_DIR=downloads
